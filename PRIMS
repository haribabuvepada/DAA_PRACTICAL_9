# Prim's Algorithm

def prim(graph):
    n = len(graph)

    # Keep track of visited vertices
    visited = [False] * n

    # Start from vertex 0
    visited[0] = True

    total_cost = 0

    print("Edges in Minimum Spanning Tree:")

    # MST contains n-1 edges
    for _ in range(n - 1):

        minimum = float('inf')
        x = -1
        y = -1

        # Find minimum weight edge
        for i in range(n):
            if visited[i]:
                for j in range(n):
                    if not visited[j] and graph[i][j] != 0:
                        if graph[i][j] < minimum:
                            minimum = graph[i][j]
                            x = i
                            y = j

        # Add edge to MST
        print(x, "-->", y, "Weight =", minimum)

        total_cost += minimum
        visited[y] = True

    print("Minimum Cost =", total_cost)


# Graph represented using adjacency matrix
graph = [
    [0, 2, 3, 0, 0],
    [2, 0, 1, 4, 0],
    [3, 1, 0, 5, 6],
    [0, 4, 5, 0, 7],
    [0, 0, 6, 7, 0]
]

prim(graph)
